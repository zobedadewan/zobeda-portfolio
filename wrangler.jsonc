{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zobeda-portfolio",
  "compatibility_date": "2026-09-18",

  // A static-assets-only Worker: there is no server code, so no "main"
  // entry point. Cloudflare serves ./dist straight from its edge.
  "assets": {
    "directory": "./dist",

    // This is the SPA fallback. The site is client-routed, so a direct hit
    // or refresh on /work/vanity-linx asks the edge for a file that does
    // not exist; without this it returns 404 instead of handing over to
    // index.html and letting React Router resolve the path.
    //
    // Do NOT also ship a public/_redirects with a catch-all SPA rule.
    // Workers Static Assets parses _redirects too, and rejects
    // `/* /index.html 200` as a self-referencing loop:
    //   "Infinite loop detected in this rule" [code: 100324]
    // which fails the deploy outright. This setting is the Workers way to
    // do it; _redirects is the Pages/Netlify way. Pick one.
    "not_found_handling": "single-page-application"
  }
}
